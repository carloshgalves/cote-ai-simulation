{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cote-sim/canon/character_evidence_legacy_collection.schema.json",
  "title": "LegacyCharacterEvidenceCollection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "collection": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "character_evidence_legacy_record.schema.json"
      }
    }
  }
}
