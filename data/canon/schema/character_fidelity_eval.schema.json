{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cote-sim/canon/character_fidelity_eval.schema.json",
  "title": "CharacterFidelityEvalSuite",
  "description": "Golden behavioral and knowledge-boundary scenarios. No model invocation is defined here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "character_id", "knowledge_horizon", "positive_cases", "contrast_cases", "anti_cases", "knowledge_leakage_cases"],
  "$defs": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario", "available_information", "expected", "forbidden", "evidence_refs"],
      "properties": {
        "id": { "type": "string" },
        "scenario": { "type": "string" },
        "available_information": { "type": "array", "items": { "type": "string" } },
        "withheld_world_truth": { "type": "array", "items": { "type": "string" } },
        "expected": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "forbidden": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^ev\\.[a-z0-9.-]+$" } },
        "contrast_with": { "type": "string" }
      }
    }
  },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "character_id": { "type": "string", "pattern": "^actor\\.[a-z0-9.-]+$" },
    "knowledge_horizon": { "type": "string", "const": "Y1_START" },
    "positive_cases": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/Case" } },
    "contrast_cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Case" } },
    "anti_cases": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/Case" } },
    "knowledge_leakage_cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/Case" },
          { "required": ["withheld_world_truth"] }
        ]
      }
    }
  }
}
