{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cote-sim/canon/conflict.schema.json",
  "title": "SourceConflict",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "question", "positions", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^conflict\\.[a-z0-9.-]+$" },
    "schema_version": { "type": "integer", "const": 1 },
    "question": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["cross-tier", "same-tier", "intra-ln-retcon", "declared-vs-observed", "third-party-arithmetic", "adaptation-only"]
    },
    "positions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "statement"],
        "properties": {
          "label": { "type": "string" },
          "statement": { "type": "string" },
          "claim": { "$ref": "common.schema.json#/$defs/ClaimId" },
          "supports": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/SourceRef" } },
          "discovered_via": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/DiscoveryRef" } }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "description": "Required for declared-vs-observed. Observed behavior does NOT automatically invalidate a declared rule.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["exception", "narrower_scope", "temporal_change", "unreliable_declaration", "unreliable_observation", "misreading"]
          },
          "note": { "type": "string" },
          "assessment": { "type": "string", "enum": ["open", "supported", "weakened", "ruled-out"], "default": "open" }
        }
      }
    },
    "status": { "type": "string", "enum": ["open", "resolved", "wontfix"] },
    "resolution": { "type": ["string", "null"] },
    "resolved_by": { "type": ["string", "null"] },
    "blocks_compilation_of": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ClaimId" },
      "description": "While open, none of these compile to the engine."
    },
    "modeling_decision": {
      "type": ["string", "null"],
      "description": "A modeling choice that holds under any resolution. Not a resolution of the conflict."
    },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "declared-vs-observed" } }, "required": ["kind"] },
      "then": { "required": ["hypotheses"], "properties": { "hypotheses": { "minItems": 2 } } }
    }
  ]
}
