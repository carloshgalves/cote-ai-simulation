{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cote-sim/canon/evidence_collection.schema.json",
  "title": "EvidenceCollection",
  "description": "File-level container for CanonEvidence V2 records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "collection": {"type": "string"},
    "note": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "evidence.schema.json"}
    }
  }
}
