{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cote-sim/embodiment/seed-evidence-v1.schema.json",
  "title": "A2 physical seeded-run source evidence, pending Go admission",
  "description": "Engine-only *reference* evidence from a verified immutable pair. NOT a CSF EventDraft, CommitCandidate, WorldState, EventOrderKey, or approved extension.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "authority",
    "admission",
    "source",
    "subjects"
  ],
  "properties": {
    "kind": {
      "const": "physical.seed-evidence.v1"
    },
    "schema_version": {
      "const": 1
    },
    "authority": {
      "const": "ENGINE_ONLY"
    },
    "admission": {
      "const": "PENDING_GO_ADMISSION"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/subject"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_raw_sha256",
        "events_raw_sha256",
        "snapshot_document_sha256",
        "normalised_log_sha256",
        "snapshot_version",
        "local_origin",
        "prior_version",
        "dynamics_version",
        "source_kind"
      ],
      "properties": {
        "snapshot_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "events_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalised_log_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_version": {
          "const": 1
        },
        "local_origin": {
          "const": "Y1_START"
        },
        "prior_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "dynamics_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "source_kind": {
          "const": "sealed-physical-seed-only"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "engine_only",
        "source_baseline_pointer",
        "source_body_pointer",
        "source_local_sample_seq",
        "posterior_hash",
        "baseline_sha256",
        "body_state_sha256"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "engine_only": {
          "const": true
        },
        "source_baseline_pointer": {
          "type": "string",
          "pattern": "^/characters/[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/capacity_baseline$",
          "maxLength": 192
        },
        "source_body_pointer": {
          "type": "string",
          "pattern": "^/characters/[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/body_state$",
          "maxLength": 192
        },
        "source_local_sample_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "posterior_hash": {
          "$ref": "#/$defs/sha256"
        },
        "baseline_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "body_state_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
