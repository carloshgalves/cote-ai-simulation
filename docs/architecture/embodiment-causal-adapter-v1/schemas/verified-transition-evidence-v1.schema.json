{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cote-sim/embodiment/verified-transition-evidence-v1.schema.json",
  "title": "A2 physical verified transition evidence (non-canonical; pending Go admission)",
  "description": "Reference-only materialization from PSV1-2 verified local prefix; does not attest command completion or confer causal authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "authority",
    "admission",
    "completion",
    "source",
    "transitions",
    "subject_tips"
  ],
  "properties": {
    "kind": {
      "const": "physical.verified-transition-evidence.v1"
    },
    "schema_version": {
      "const": 1
    },
    "authority": {
      "const": "ENGINE_ONLY"
    },
    "admission": {
      "const": "PENDING_GO_ADMISSION"
    },
    "completion": {
      "const": "UNATTESTED_PREFIX"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "subject_tips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/tip"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_raw_sha256",
        "events_raw_sha256",
        "snapshot_document_sha256",
        "normalised_log_sha256",
        "snapshot_version",
        "local_origin",
        "prior_version",
        "dynamics_version",
        "log_record_count",
        "verified_transition_count"
      ],
      "properties": {
        "snapshot_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "events_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalised_log_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_version": {
          "const": 1
        },
        "local_origin": {
          "const": "Y1_START"
        },
        "prior_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "dynamics_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "log_record_count": {
          "type": "integer",
          "minimum": 4,
          "maximum": 100000
        },
        "verified_transition_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99997
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "source_local_seq",
        "source_local_sim_time",
        "source_local_after_hours",
        "source_local_delta_hours",
        "source_segment",
        "semantic_record_sha256",
        "channel_diff_sha256"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/subject_id"
        },
        "source_local_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999
        },
        "source_local_sim_time": {
          "type": "string",
          "pattern": "^Y1_START\\+[0-9]{5}\\.[0-9]{3}h$",
          "minLength": 22,
          "maxLength": 22
        },
        "source_local_after_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 99999
        },
        "source_local_delta_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 24
        },
        "source_segment": {
          "type": "string",
          "enum": [
            "awake",
            "asleep"
          ]
        },
        "semantic_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "channel_diff_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "tip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "last_local_seq",
        "verified_body_sha256",
        "verified_advance_count",
        "visibility"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/subject_id"
        },
        "last_local_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999
        },
        "verified_body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verified_advance_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99997
        },
        "visibility": {
          "const": "ENGINE_ONLY"
        }
      }
    }
  }
}
